{
  "name": "libmasscan",
  "version": "0.1.2",
  "description": "In-process Node.js bindings for the masscan port scanner",
  "main": "index.js",
  "author": "Jason Gerfen",
  "license": "AGPL-3.0",
  "keywords": [
    "masscan",
    "port-scanner",
    "port-scan",
    "network-scanner",
    "scanner",
    "tcp",
    "udp",
    "syn-scan",
    "banner-grabbing",
    "network",
    "security",
    "pentest",
    "reconnaissance",
    "pcap",
    "native",
    "addon",
    "n-api",
    "napi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jas-/libmasscan.git"
  },
  "bugs": {
    "url": "https://github.com/jas-/libmasscan/issues"
  },
  "gypfile": true,
  "os": [
    "linux",
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "binding.gyp",
    "scripts/",
    "src/*.c",
    "src/*.h",
    "src/shim/",
    "src/masscan/src/",
    "src/masscan/LICENSE",
    "examples/",
    "!examples/consumer"
  ],
  "scripts": {
    "install": "node scripts/fetch-masscan.js && node-gyp rebuild",
    "build": "node scripts/fetch-masscan.js && node-gyp rebuild -j max",
    "prepack": "node scripts/fetch-masscan.js --check",
    "test": "node --test test/*.test.js"
  },
  "masscan": {
    "repository": "https://github.com/robertdavidgraham/masscan",
    "commit": "8e6b3b0c07a81e8ea61d557c06134a21a6881614"
  }
}
