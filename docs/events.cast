[0.003, "o", "\u001b[1;35mconst\u001b[0m masscan = \u001b[1;35mrequire\u001b[0m(\u001b[33m'libmasscan'\u001b[0m);\r\n\u001b[1;35mconst\u001b[0m opts = \u001b[1;35mrequire\u001b[0m(\u001b[33m'./lab-opts'\u001b[0m);\r\n\r\n\u001b[1;35mconst\u001b[0m scan = masscan.scan(opts);\r\n"]
